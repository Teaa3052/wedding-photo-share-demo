# Server
PORT=3000
BASE_URL=http://localhost:3000

# Wedding branding
WEDDING_NAMES=Mladenka & Mladoženja
WEDDING_DATE=20.06.2026
# 32 MB is App Engine's own request size limit.
MAX_FILE_MB=32
# Uploads larger than this get resized/recompressed to JPEG before they're stored.
COMPRESS_ABOVE_MB=3
MAX_FILES_PER_BATCH=5

# Admin (used only for deleting uploads and viewing setup status)
ADMIN_PASSWORD=CHANGE_ME

# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Generate with: npm run google:authorize
# Paste the resulting refresh token here.
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# Optional. Leave blank for automatic folder creation.
DRIVE_FOLDER_ID=
